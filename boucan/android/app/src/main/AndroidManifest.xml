<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibration au toucher, micro pour les cases MICRO, effets audio. Pas d'accès Internet. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Lecteur intégré : lire les fichiers de musique du téléphone. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Lecteur intégré : commandes dans les notifications, musique qui continue en arrière-plan. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Requis par Android pour voir et piloter le lecteur de musique en cours (case PLAYER). -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Widgets de l'écran d'accueil : lecteur de musique, grille de cases. -->
        <receiver
            android:name=".MusicWidget"
            android:exported="false"
            android:label="@string/w_music">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_music" />
        </receiver>
        <receiver
            android:name=".PadWidget"
            android:exported="false"
            android:label="@string/w_pads">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_pads" />
        </receiver>
        <!-- Relais invisible d'un widget quand l'appli est fermée : il la relance. -->
        <activity
            android:name=".WidgetTap"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Sert le fichier .boucan exporté aux apps de partage (WhatsApp, Bluetooth…). -->
        <provider
            android:name=".ExportProvider"
            android:authorities="${applicationId}.export"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
